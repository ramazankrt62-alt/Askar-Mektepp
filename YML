name: Android APK Build

on:
  push:
    branches: [ main ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Kodu al
        uses: actions/checkout@v4

      - name: Java 17 kur
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Node 20 kur
        uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'

      - name: Gradle cache
        uses: actions/cache@v4
        with:
          path: |
            ~/.gradle/caches
            ~/.gradle/wrapper
          key: gradle-${{ runner.os }}-${{ hashFiles('**/*.gradle*') }}
          restore-keys: |
            gradle-${{ runner.os }}-

      - name: NPM bagimliliklarini yukle
        run: npm install

      - name: Android platformu ekle (yoksa)
        run: |
          if [ ! -d "android" ]; then
            npx cap add android
          fi

      - name: Capacitor senkronize et
        run: npx cap sync android

      - name: Uygulama ikonunu yerlestir (xxxhdpi, tek dosyadan)
        run: |
          mkdir -p android/app/src/main/res/mipmap-xxxhdpi
          cp android-icons/mipmap-xxxhdpi/ic_launcher.png android/app/src/main/res/mipmap-xxxhdpi/ic_launcher.png
          cp android-icons/mipmap-xxxhdpi/ic_launcher.png android/app/src/main/res/mipmap-xxxhdpi/ic_launcher_round.png
          cp android-icons/mipmap-xxxhdpi/ic_launcher.png android/app/src/main/res/mipmap-xxxhdpi/ic_launcher_foreground.png

      - name: Gradlew calistirilabilir yap
        run: chmod +x android/gradlew

      - name: Debug APK derle
        working-directory: android
        run: ./gradlew assembleDebug --stacktrace

      - name: APK'yi yukle (artifact)
        uses: actions/upload-artifact@v4
        with:
          name: askar-mektep-debug-apk
          path: android/app/build/outputs/apk/debug/app-debug.apk
